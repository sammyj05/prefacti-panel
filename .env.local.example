# Prefacti — variables del proyecto de Supabase.
#
# Copia este fichero a `.env.local` y rellena los tres valores. Están en el
# panel de Supabase, en Project Settings → API.
#
# Las dos primeras viajan al navegador y eso es correcto: la clave anónima está
# pensada para ser pública. Lo que impide leer la cartera de otra empresa no es
# el secreto de la clave, es RLS.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Ésta NO viaja al navegador y se salta RLS entera. Sólo la usan los guiones de
# carga que se ejecutan a mano desde `scripts/`. Nunca en código de la
# aplicación, y nunca en un fichero que se suba al repositorio.
SUPABASE_SERVICE_ROLE_KEY=
